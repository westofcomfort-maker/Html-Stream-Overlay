<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=1920, height=1080, initial-scale=1.0">
<title>Thats Atlas — Victorian Gothic OBS Overlay</title>

<!--
  THATS ATLAS — VICTORIAN GOTHIC STREAM OVERLAY
  ------------------------------------------------
  OBS Browser Source:
    Width: 1920
    Height: 1080
    Custom CSS: leave blank
    Background: transparent

  Architecture is intentionally modular/configurable:
    1. Theme variables
    2. Full-screen overlay shell
    3. Decorative Victorian frame
    4. Brand plaque
    5. Webcam window
    6. Chat notice board
    7. Stream status / stats
    8. Rotating lower plaque
    9. JS configuration + controls

  Keyboard:
    H = hide/show lower plaque
    B = hide/show decorative border
-->

<style>
:root {
  --void: #090807;
  --ink: #11100f;
  --mahogany: #2a1714;
  --walnut: #3a241c;
  --wood-dark: #170f0d;
  --stone: #77706a;
  --bone: #d2c5af;
  --bronze: #8b6a3f;
  --copper: #b27a4b;
  --burgundy: #4d171c;
  --ember: #c08a55;

  --frame-w: 3px;
  --safe-top: 26px;
  --safe-side: 30px;
  --chat-w: 350px;
  --chat-h: 600px;
}

* { box-sizing: border-box; }

html, body {
  width: 100%;
  height: 100%;
  margin: 0;
  overflow: hidden;
  background: transparent;
  font-family: Georgia, "Times New Roman", serif;
  color: var(--bone);
  pointer-events: none;
}

#overlay {
  position: fixed;
  inset: 0;
  width: 1920px;
  height: 1080px;
  overflow: hidden;
  pointer-events: none;
  background:
    radial-gradient(ellipse at 50% 48%, transparent 48%, rgba(0,0,0,.38) 100%);
  transition: opacity .25s ease;
}

#overlay.hidden { opacity: 0; }
#overlay.border-off .gothic-frame { opacity: 0; }

/* =========================================================
   VICTORIAN GOTHIC ARCHITECTURE
   ========================================================= */

.gothic-frame {
  position: absolute;
  inset: 18px;
  border: var(--frame-w) solid rgba(139,106,63,.78);
  box-shadow:
    inset 0 0 0 7px rgba(16,10,8,.95),
    inset 0 0 0 10px rgba(178,122,75,.30),
    0 0 22px rgba(0,0,0,.75);
  transition: opacity .25s ease;
}

.gothic-frame::before,
.gothic-frame::after {
  content: "";
  position: absolute;
  inset: 10px;
  border: 1px solid rgba(210,197,175,.17);
  pointer-events: none;
}

.corner {
  position: absolute;
  width: 115px;
  height: 115px;
  border-color: var(--copper);
  opacity: .72;
}

.corner.tl { top: -3px; left: -3px; border-top: 7px double; border-left: 7px double; }
.corner.tr { top: -3px; right: -3px; border-top: 7px double; border-right: 7px double; }
.corner.bl { bottom: -3px; left: -3px; border-bottom: 7px double; border-left: 7px double; }
.corner.br { bottom: -3px; right: -3px; border-bottom: 7px double; border-right: 7px double; }

.rosette {
  position: absolute;
  width: 46px;
  height: 46px;
  border: 2px solid var(--bronze);
  border-radius: 50%;
  background:
    radial-gradient(circle, var(--burgundy) 0 20%, transparent 21% 42%, var(--bronze) 43% 47%, transparent 48%),
    repeating-conic-gradient(from 0deg, rgba(178,122,75,.7) 0 8deg, transparent 8deg 24deg);
  box-shadow: 0 0 10px rgba(0,0,0,.7);
}
.rosette.tl { top: 28px; left: 28px; }
.rosette.tr { top: 28px; right: 28px; }
.rosette.bl { bottom: 28px; left: 28px; }
.rosette.br { bottom: 28px; right: 28px; }

/* =========================================================
   BRAND PLAQUE
   ========================================================= */

.brand {
  position: absolute;
  top: 48px;
  left: 55px;
  width: 405px;
  min-height: 108px;
  padding: 18px 24px 16px 88px;
  background:
    linear-gradient(90deg, rgba(61,35,27,.97), rgba(28,16,14,.97));
  border: 2px solid var(--bronze);
  box-shadow:
    inset 0 0 0 5px rgba(9,7,6,.72),
    inset 0 0 0 7px rgba(178,122,75,.18),
    8px 9px 20px rgba(0,0,0,.55);
  clip-path: polygon(
    0 13px, 13px 0, calc(100% - 13px) 0, 100% 13px,
    100% calc(100% - 13px), calc(100% - 13px) 100%,
    13px 100%, 0 calc(100% - 13px)
  );
}

.brand::after {
  content: "";
  position: absolute;
  left: 18px;
  right: 18px;
  bottom: 10px;
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--copper), transparent);
  opacity: .65;
}

.brand-logo {
  position: absolute;
  left: 16px;
  top: 15px;
  width: 60px;
  height: 60px;
  object-fit: contain;
  filter: sepia(.5) contrast(1.15) brightness(.8);
}

.brand-monogram {
  position: absolute;
  left: 17px;
  top: 16px;
  width: 58px;
  height: 58px;
  display: grid;
  place-items: center;
  border: 2px solid var(--copper);
  color: var(--bone);
  font-size: 24px;
  font-weight: bold;
  letter-spacing: 3px;
}

.brand-title {
  font-size: 34px;
  line-height: 1;
  letter-spacing: 5px;
  text-transform: uppercase;
  font-weight: 700;
  text-shadow: 2px 2px 0 #000;
}

.brand-sub {
  margin-top: 10px;
  font-size: 12px;
  letter-spacing: 4px;
  color: #ad9d87;
  text-transform: uppercase;
}

/* =========================================================
   LIVE INDICATOR
   ========================================================= */

.live {
  position: absolute;
  top: 58px;
  left: 490px;
  display: flex;
  align-items: center;
  gap: 10px;
  height: 35px;
  padding: 0 15px;
  background: rgba(16,10,9,.92);
  border-left: 3px solid var(--burgundy);
  border-right: 1px solid var(--bronze);
  font-size: 12px;
  letter-spacing: 3px;
  text-transform: uppercase;
}

.live-dot {
  width: 9px;
  height: 9px;
  border-radius: 50%;
  background: #a62c32;
  box-shadow: 0 0 8px rgba(166,44,50,.85);
  animation: pulse 1.5s infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: .35; transform: scale(.72); }
}

/* =========================================================
   VICTORIAN WEBCAM — LANCET WINDOW
   ========================================================= */

.webcam {
  position: absolute;
  left: 52px;
  bottom: 102px;
  width: 390px;
  height: 430px;
  background: rgba(5,5,5,.08);
  border: 3px solid var(--bronze);
  clip-path: polygon(
    0 12%, 50% 0, 100% 12%, 100% 100%, 0 100%
  );
  filter: drop-shadow(7px 9px 13px rgba(0,0,0,.6));
}

.webcam::before {
  content: "";
  position: absolute;
  inset: 11px;
  border: 2px solid rgba(178,122,75,.6);
  clip-path: polygon(
    0 12%, 50% 0, 100% 12%, 100% 100%, 0 100%
  );
  box-shadow: inset 0 0 30px rgba(0,0,0,.75);
}

.webcam::after {
  content: "CAMERA";
  position: absolute;
  bottom: 14px;
  left: 50%;
  transform: translateX(-50%);
  padding: 6px 17px;
  background: rgba(23,15,13,.95);
  border: 1px solid var(--copper);
  font-size: 10px;
  letter-spacing: 4px;
  color: var(--bone);
}

.webcam-cross {
  position: absolute;
  inset: 0;
  opacity: .14;
}
.webcam-cross::before {
  content: "";
  position: absolute;
  top: 0; bottom: 0; left: 50%;
  border-left: 2px solid var(--bone);
}
.webcam-cross::after {
  content: "";
  position: absolute;
  left: 0; right: 0; top: 27%;
  border-top: 2px solid var(--bone);
}

/* =========================================================
   CHAT — VICTORIAN NOTICE BOARD
   ========================================================= */

.chat {
  position: absolute;
  top: 205px;
  right: 55px;
  width: var(--chat-w);
  height: var(--chat-h);
  background:
    linear-gradient(135deg, rgba(51,29,23,.97), rgba(18,12,11,.98));
  border: 3px solid var(--bronze);
  box-shadow:
    inset 0 0 0 7px rgba(10,7,6,.88),
    inset 0 0 0 9px rgba(178,122,75,.19),
    10px 12px 24px rgba(0,0,0,.62);
}

.chat::before {
  content: "";
  position: absolute;
  inset: 14px;
  border: 1px solid rgba(210,197,175,.25);
  pointer-events: none;
}

.chat-header {
  height: 65px;
  display: flex;
  align-items: center;
  padding: 0 22px;
  border-bottom: 1px solid rgba(178,122,75,.5);
  background: rgba(8,6,5,.58);
}

.chat-title {
  font-size: 17px;
  letter-spacing: 4px;
  text-transform: uppercase;
}

.chat-ornament {
  margin-left: auto;
  width: 42px;
  height: 22px;
  border-top: 1px solid var(--copper);
  border-bottom: 1px solid var(--copper);
  transform: skewX(-25deg);
}

.chat iframe {
  position: absolute;
  left: 17px;
  right: 17px;
  top: 76px;
  bottom: 16px;
  width: calc(100% - 34px);
  height: calc(100% - 92px);
  border: 0;
  background: transparent;
}

/* =========================================================
   STATUS / STATS PLAQUE
   ========================================================= */

.status {
  position: absolute;
  right: 55px;
  bottom: 57px;
  width: 350px;
  height: 90px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  background: rgba(20,12,11,.94);
  border: 2px solid var(--bronze);
  box-shadow: inset 0 0 0 5px rgba(0,0,0,.65), 6px 8px 16px rgba(0,0,0,.5);
}

.stat {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding-left: 22px;
}
.stat + .stat { border-left: 1px solid rgba(178,122,75,.35); }

.stat-label {
  font-size: 10px;
  letter-spacing: 3px;
  color: #9d8e7c;
  text-transform: uppercase;
}
.stat-value {
  margin-top: 5px;
  font-size: 19px;
  letter-spacing: 2px;
  color: var(--bone);
}

/* =========================================================
   LOWER VICTORIAN PLAQUE / ROTATING COPY
   ========================================================= */

.promo {
  position: absolute;
  left: 485px;
  bottom: 52px;
  width: 700px;
  min-height: 112px;
  padding: 19px 30px 18px;
  background:
    linear-gradient(180deg, rgba(44,25,21,.96), rgba(15,10,9,.96));
  border: 2px solid var(--copper);
  box-shadow:
    inset 0 0 0 5px rgba(6,5,4,.75),
    0 10px 25px rgba(0,0,0,.55);
  text-align: center;
}

.promo::before,
.promo::after {
  content: "◆";
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  color: var(--bronze);
  font-size: 16px;
}
.promo::before { left: 15px; }
.promo::after { right: 15px; }

.promo-kicker {
  font-size: 10px;
  letter-spacing: 5px;
  text-transform: uppercase;
  color: #a8957b;
}

.promo-main {
  margin-top: 8px;
  font-size: 24px;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: var(--bone);
  text-shadow: 2px 2px 0 #000;
}

.promo-small {
  margin-top: 7px;
  font-size: 11px;
  letter-spacing: 2px;
  color: #9c8975;
}

/* =========================================================
   CHANNEL TAG + DECORATIVE IRONWORK
   ========================================================= */

.channel-tag {
  position: absolute;
  left: 55px;
  bottom: 48px;
  min-width: 350px;
  height: 45px;
  padding: 0 19px;
  display: flex;
  align-items: center;
  gap: 12px;
  background: rgba(13,9,8,.94);
  border-left: 5px solid var(--burgundy);
  border-top: 1px solid var(--bronze);
  border-bottom: 1px solid var(--bronze);
  box-shadow: 5px 7px 15px rgba(0,0,0,.55);
}

.channel-tag span {
  font-size: 13px;
  letter-spacing: 3px;
  text-transform: uppercase;
}

.iron-line {
  position: absolute;
  top: 178px;
  left: 55px;
  width: 360px;
  height: 1px;
  background: linear-gradient(90deg, var(--copper), transparent);
  opacity: .55;
}

.lancet {
  position: absolute;
  top: 48px;
  right: 500px;
  width: 110px;
  height: 155px;
  border: 2px solid rgba(139,106,63,.42);
  border-radius: 55px 55px 0 0;
  opacity: .22;
}
.lancet::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 0;
  bottom: 0;
  border-left: 1px solid var(--bone);
}
.lancet::after {
  content: "";
  position: absolute;
  left: 12px;
  right: 12px;
  top: 55%;
  border-top: 1px solid var(--bone);
}

/* Decorative molding across bottom */
.molding {
  position: absolute;
  left: 485px;
  right: 430px;
  bottom: 29px;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(178,122,75,.55), transparent);
}
.molding::before,
.molding::after {
  content: "";
  position: absolute;
  width: 9px;
  height: 9px;
  top: -4px;
  border: 1px solid var(--bronze);
  transform: rotate(45deg);
}
.molding::before { left: 5%; }
.molding::after { right: 5%; }

/* =========================================================
   RESPONSIVE / OBS SAFE
   ========================================================= */

@media (max-width: 1500px) {
  .brand { transform: scale(.86); transform-origin: top left; }
  .chat { transform: scale(.82); transform-origin: top right; }
  .webcam { transform: scale(.82); transform-origin: bottom left; }
  .promo { transform: scale(.82); transform-origin: bottom left; }
  .status { transform: scale(.82); transform-origin: bottom right; }
}
</style>
</head>

<body>
<div id="overlay">

  <div class="gothic-frame">
    <div class="corner tl"></div><div class="corner tr"></div>
    <div class="corner bl"></div><div class="corner br"></div>
    <div class="rosette tl"></div><div class="rosette tr"></div>
    <div class="rosette bl"></div><div class="rosette br"></div>
  </div>

  <div class="brand">
    <img class="brand-logo" src="data:image/jpeg;base64," alt="Thats Atlas logo">
    <div class="brand-title">THATS ATLAS</div>
    <div class="brand-sub">Victorian Gaming Parlour</div>
  </div>

  <div class="live">
    <span class="live-dot"></span>
    <span>Live Transmission</span>
  </div>

  <div class="lancet"></div>
  <div class="iron-line"></div>

  <div class="webcam">
    <div class="webcam-cross"></div>
  </div>

  <section class="chat">
    <div class="chat-header">
      <div class="chat-title">The Parlour</div>
      <div class="chat-ornament"></div>
    </div>
    <!-- Replace this URL with your platform's chat popout URL. -->
    <iframe
      title="Chat"
      src="about:blank"
      allowtransparency="true">
    </iframe>
  </section>

  <section class="status">
    <div class="stat">
      <div class="stat-label">Session</div>
      <div class="stat-value" id="session">00:00:00</div>
    </div>
    <div class="stat">
      <div class="stat-label">Status</div>
      <div class="stat-value">IN SESSION</div>
    </div>
  </section>

  <section class="promo" id="promo">
    <div class="promo-kicker" id="promoKicker">NOTICE FROM THE ESTATE</div>
    <div class="promo-main" id="promoMain">THE BURDEN REMAINS.</div>
    <div class="promo-small" id="promoSmall">Please remain seated. Atlas has matters to attend to.</div>
  </section>

  <div class="channel-tag">
    <span>Thats Atlas</span>
    <span>•</span>
    <span>Gaming / PvP / Chat</span>
  </div>

  <div class="molding"></div>
</div>

<script>
/* =========================================================
   CONFIGURATION
   ========================================================= */

const CONFIG = {
  promoIntervalMs: 20 * 60 * 1000,
  sessionStart: Date.now(),

  promos: [
    {
      kicker: "NOTICE FROM THE ESTATE",
      main: "THE BURDEN REMAINS.",
      small: "Please remain seated. Atlas has matters to attend to."
    },
    {
      kicker: "HOUSE ANNOUNCEMENT",
      main: "CHAOS, WITH PROPER ETIQUETTE.",
      small: "PvP, poor decisions, and the occasional respectable victory."
    },
    {
      kicker: "OFFICIAL RECORD",
      main: "ATLAS ACCEPTS NO RESPONSIBILITY.",
      small: "All incidents are considered part of the entertainment."
    },
    {
      kicker: "EVENING PROGRAMME",
      main: "ENTER THE PARLOUR.",
      small: "Games, gossip, and Victorian-grade questionable judgment."
    }
  ]
};

let promoIndex = 0;
const overlay = document.getElementById("overlay");
const promo = document.getElementById("promo");
const promoKicker = document.getElementById("promoKicker");
const promoMain = document.getElementById("promoMain");
const promoSmall = document.getElementById("promoSmall");
const session = document.getElementById("session");

function renderPromo(index) {
  const item = CONFIG.promos[index];
  promoKicker.textContent = item.kicker;
  promoMain.textContent = item.main;
  promoSmall.textContent = item.small;
}

function rotatePromo() {
  promoIndex = (promoIndex + 1) % CONFIG.promos.length;
  renderPromo(promoIndex);
}

function updateSession() {
  const elapsed = Math.max(0, Date.now() - CONFIG.sessionStart);
  const totalSeconds = Math.floor(elapsed / 1000);
  const h = String(Math.floor(totalSeconds / 3600)).padStart(2, "0");
  const m = String(Math.floor((totalSeconds % 3600) / 60)).padStart(2, "0");
  const s = String(totalSeconds % 60).padStart(2, "0");
  session.textContent = `${h}:${m}:${s}`;
}

renderPromo(0);
setInterval(rotatePromo, CONFIG.promoIntervalMs);
setInterval(updateSession, 1000);
updateSession();

/* H = hide/show lower plaque. B = hide/show architectural frame. */
document.addEventListener("keydown", (event) => {
  if (event.key.toLowerCase() === "h") {
    promo.style.display = promo.style.display === "none" ? "" : "none";
  }
  if (event.key.toLowerCase() === "b") {
    overlay.classList.toggle("border-off");
  }
});
</script>
</body>
</html>
